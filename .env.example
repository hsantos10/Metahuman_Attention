# Copy to .env and edit. Loaded by src/pipeline/config_loader.py; a value here beats the YAML and loses to the shell.
# Values below are the ones used for the paper's final (v2) runs.

# --- Read at import time: set these in the shell, not here ---
# GROUNDLINK_ROOT=/path/to/GroundLink          GroundLink C3D / force root
# TAMU_DATA_ROOT="/path/to/TAMU Data"          root of the Patient Handling OpenSim folders and Experiment Detail.xlsx

# --- Dataset and run ---
# SELECTED_DATASET: GROUNDLINK | PATIENT_HANDLING | COMBINED (no inline comments: the loader keeps them in the value)
SELECTED_DATASET=GROUNDLINK
RUN_NAME_OVERRIDE=groundlink_full_train
MODELS_TO_RUN=ImprovedConvFormer
USE_LOSO=0
CROSS_LAB_SUBJECT=ph_1
LOSO_EPOCHS_OVERRIDE=500

# --- Data processing ---
GLOBAL_MAX_LEN_OVERRIDE=2500
MAX_PAIRED_FILES_OVERRIDE=0
TRC_MARKER_UNITS_MODE=mm
FORCE_TARGET_MODE=nbw
ENABLE_BIOMECH_PREPROCESSING=1
USE_BILATERAL_FLIP=1
GROUNDLINK_STRICT_TARGET_COLUMNS=1
GROUNDLINK_ENABLE_DATA_DIAGNOSTICS=0
# The released GroundLink force arrays are in kN
GROUNDLINK_GRF_UNITS=kilonewton
GROUNDLINK_MARKER_UNITS=mm
GROUNDLINK_TARGET_NORMALIZATION_MODE=standard

# --- Training schedule (standard pipeline) ---
TRAIN_ENABLE_DIAGNOSTICS=0
SKIP_COMPLETED_MODELS=1
HPO_TRIALS_OVERRIDE=50
HPO_EPOCHS_OVERRIDE=25
SANITY_EPOCHS_OVERRIDE=30
FINAL_EPOCHS_OVERRIDE=500
EARLY_STOPPING_PATIENCE_OVERRIDE=50
EARLY_STOPPING_MIN_DELTA_OVERRIDE=0.0
SANITY_LOSS_ABORT_THRESHOLD_OVERRIDE=10.0
SANITY_ABORT_EPOCH_WINDOW_OVERRIDE=2
