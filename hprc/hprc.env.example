# Copy to hprc/hprc.env and edit. Sourced by hprc/activate.sh and hprc/setup_env.sh.
HPRC_ACCOUNT=YOUR_ACCOUNT
REMOTE_ROOT=/scratch/user/$USER/metahuman
REMOTE_CODE=$REMOTE_ROOT/code
REMOTE_DATA="$REMOTE_ROOT/data/TAMU Data"          # contains 01.PatientHandlingTasks/
REMOTE_GROUNDLINK=$REMOTE_ROOT/data/GroundLink     # contains c3d/c3d/<subject>/*.c3d and force/force/<s>_force/<s>/*.npy
REMOTE_VENV=$REMOTE_ROOT/venv
